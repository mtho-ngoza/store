### Product API Requests

### Base URL
@baseUrl = http://localhost:8080
@contentType = application/json

###
# Get all products (default pagination: page=0, size=20)
GET {{baseUrl}}/products
Accept: {{contentType}}

###
# Get all products with custom pagination
GET {{baseUrl}}/products?page=5&size=10
Accept: {{contentType}}

###
# Get all products sorted by description ascending
GET {{baseUrl}}/products?page=0&size=20&sort=description,asc
Accept: {{contentType}}

###
# Get product by ID (existing)
GET {{baseUrl}}/products/1
Accept: {{contentType}}

###
# Get product by ID (non-existent - should return 404)
GET {{baseUrl}}/products/99999
Accept: {{contentType}}

###
# Create a new product
POST {{baseUrl}}/products
Content-Type: {{contentType}}

{
  "description": "Football"
}

###
# Create another product
POST {{baseUrl}}/products
Content-Type: {{contentType}}

{
  "description": "Basketball"
}

###
# Create product - Electronics
POST {{baseUrl}}/products
Content-Type: {{contentType}}

{
  "description": "Laptop"
}
